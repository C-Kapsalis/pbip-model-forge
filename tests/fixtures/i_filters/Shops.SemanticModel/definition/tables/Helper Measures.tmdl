table 'Helper Measures'
	lineageTag: helper-measures

	measure 'i-Applied Filters' = ""
		lineageTag: i-applied-filters

	measure 'Blank Measure' = BLANK()
		lineageTag: blank-measure

	partition 'Helper Measures' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WUlCKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [z = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"z"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table
