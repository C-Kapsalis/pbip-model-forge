/// Measure home table: all user-facing measures live here.
table 'Key Measures'
	lineageTag: 5333f173-2ce0-5e23-90a1-e259d2b71edf

	/// Total net revenue across order lines.
	measure 'Total Revenue' = SUM(Sales[net_amount])
		formatString: $ #,0.00
		displayFolder: Base
		lineageTag: b31ef6b5-e080-50ed-8572-666b4e3a0ba7

	/// Number of distinct orders.
	measure 'Orders #' = DISTINCTCOUNT(Sales[order_id])
		formatString: #,0
		displayFolder: Counts
		lineageTag: b41979b8-c4cb-5703-8c7c-47e8e90732d3

	/// Total units sold across order lines.
	measure 'Total Units' = SUM(Sales[quantity])
		formatString: #,0
		displayFolder: Base
		lineageTag: 4c15f8e4-fc88-5431-be8c-450ea8d785b3

	/// Average net revenue per order.
	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Orders #])
		formatString: $ #,0.00
		displayFolder: Ratios
		lineageTag: 4d119d7d-1aa4-58de-8132-e59f39494534

	partition 'Key Measures' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WUlCKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [z = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"z"})
				in
				    #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
